# Copy to infra/.env.prod. Never commit real secrets.
API_DOMAIN=api.example.com
WEB_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_ENV=production
JWT_SECRET=
CORS_ORIGINS=https://example.com,https://admin.example.com
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# S3-compatible private bucket; endpoint can be blank for AWS S3.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1 # Use auto for Cloudflare R2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
IMAGE_GENERATION_MODEL=gpt-image-1
VOICE_GENERATION_MODEL=gpt-4o-mini-tts
MEDIA_MAX_BYTES=20000000
MEDIA_DAILY_IMAGE_LIMIT=5
MEDIA_DAILY_VOICE_CHARACTERS=10000
# Set these from current provider pricing; monthly cap is a hard application reservation limit.
MEDIA_MONTHLY_BUDGET_USD=0
MEDIA_IMAGE_ESTIMATED_COST_USD=0
MEDIA_VOICE_ESTIMATED_COST_PER_1K_CHARS_USD=0
