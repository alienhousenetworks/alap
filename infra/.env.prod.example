# Copy to infra/.env.prod. Use unique randomly generated secrets.
WEB_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=alap
POSTGRES_USER=alap
POSTGRES_PASSWORD=replace-with-long-url-safe-random-secret
REDIS_PASSWORD=replace-with-long-url-safe-random-secret
DATABASE_URL=postgresql+asyncpg://alap:replace-with-long-url-safe-random-secret@postgres:5432/alap
REDIS_URL=redis://:replace-with-long-url-safe-random-secret@redis:6379/0

APP_ENV=production
APP_NAME=ALAP API
API_V1_PREFIX=/api/v1
JWT_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://app.example.com,https://admin.example.com
LOG_LEVEL=INFO

AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=
MEMORY_EXTRACTION_MODEL=

# Private S3-compatible object storage. Bucket must not be public.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=alap-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_IMAGE_MODEL=gpt-image-1
MEDIA_TTS_MODEL=tts-1
MEDIA_IMAGE_DAILY_LIMIT=5
MEDIA_SPEECH_DAILY_LIMIT=30

# Encrypted PostgreSQL backups require age.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/alap
