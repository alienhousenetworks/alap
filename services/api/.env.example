APP_ENV=development
APP_NAME=ALAP API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://alap:change-me@localhost:5432/alap
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=alap-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

IMAGE_GENERATION_MODEL=gpt-image-1
VOICE_GENERATION_MODEL=gpt-4o-mini-tts
MEDIA_MAX_BYTES=20000000
MEDIA_DAILY_IMAGE_LIMIT=5
MEDIA_DAILY_VOICE_CHARACTERS=10000
MEDIA_MONTHLY_BUDGET_USD=0
MEDIA_IMAGE_ESTIMATED_COST_USD=0
MEDIA_VOICE_ESTIMATED_COST_PER_1K_CHARS_USD=0
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=alap-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
