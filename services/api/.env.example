APP_ENV=development
APP_NAME=ALAP API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://alap:change-me@localhost:5432/alap
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=alap-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MEMORY_ENCRYPTION_KEY=
MEMORY_EXTRACTION_MODEL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=alap-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_IMAGE_MODEL=gpt-image-1
MEDIA_TTS_MODEL=tts-1
MEDIA_IMAGE_DAILY_LIMIT=5
MEDIA_SPEECH_DAILY_LIMIT=30
